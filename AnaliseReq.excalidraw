    {
      "id": "kUJSjnLdEqSHdDVns_AOd",
      "type": "text",
      "x": -2035.3475614606882,
      "y": -1597.2127850931029,
      "width": 1194.8025767008464,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 1649706488,
      "version": 364,
      "versionNonce": 149611768,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787072624293,
      "link": null,
      "locked": false,
      "text": " Produto inativo não pode ser vendido.\n O estoque não pode ficar negativo.\n O preço do produto deve ser congelado no momento da compra.\n O estoque deve ser atualizado apenas quando o pedido for criado.\n O pedido deve possuir pelo menos um item.\n O total deve ser calculado pelo backend.\n O pedido deve respeitar as transições de status.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " Produto inativo não pode ser vendido.\n O estoque não pode ficar negativo.\n O preço do produto deve ser congelado no momento da compra.\n O estoque deve ser atualizado apenas quando o pedido for criado.\n O pedido deve possuir pelo menos um item.\n O total deve ser calculado pelo backend.\n O pedido deve respeitar as transições de status.",
      "autoResize": false,
      "lineHeight": 1.25
    },
